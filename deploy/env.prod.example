# CRM Chat Center — production (copy to deploy/.env.prod, fill secrets).
# Do NOT commit deploy/.env.prod

# --- DNS & TLS ---
DOMAIN=example.com
ACME_EMAIL=ops@example.com
COMPOSE_PROFILES=with-proxy

# --- Images (pin tags from your registry) ---
# Local / manual tags:
CRM_API_IMAGE=crm-api:latest
CRM_WORKER_IMAGE=crm-worker:latest
CRM_FRONTEND_IMAGE=crm-frontend:latest
#
# GHCR via override (recommended for production CD):
#   cp deploy/prod/docker-compose.override.yaml.example deploy/prod/docker-compose.override.yaml
#   GHCR_OWNER=your-github-org-or-user
#   CRM_IMAGE_TAG=v1.2.3
#   SKIP_COMPOSE_BUILD=1
# Deploy Production workflow sets CRM_IMAGE_TAG from the version input.

# --- App secrets ---
JWT_SECRET=CHANGE_ME_min_32_characters________
PGCRYPTO_KEY=CHANGE_ME_pgcrypto_key_________

# --- Database ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=crm
# Password here must match POSTGRES_PASSWORD (migrate_and_up validates this).
DATABASE_URL=postgresql+asyncpg://crm:CHANGE_ME_postgres_password@postgres:5432/crm
REDIS_URL=redis://redis:6379/0

# --- Object storage ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=CHANGE_ME_minio_password
S3_BUCKET_FILES=crm-files
S3_BUCKET_BACKUPS=crm-backups

# --- Post-deploy smoke (production uses real Let's Encrypt — do not set SMOKE_TLS_INSECURE) ---
# SMOKE_EMAIL=ops-smoke@example.com
# SMOKE_PASSWORD=CHANGE_ME_smoke_password

# --- Runtime ---
APP_ENV=production
APP_DEBUG=false
OWNERSHIP_V2=true
METRICS_ENABLED=true
WORKERS_IN_API=false
CORS_ALLOWED_ORIGINS=https://app.example.com
LOG_JSON=true
LOG_LEVEL=INFO

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# --- Frontend build args ---
VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_WS_URL=wss://api.example.com/api/v1/ws
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production

# --- SMTP ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=no-reply@example.com

# --- No admin seed in production ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Grafana (monitoring overlay; use strong credentials) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana
GRAFANA_ROOT_URL=https://grafana.example.com

# --- Leads v1.2 (enable only after WAVE-2 prod cutover + 2+ weeks stable prod) ---
# LEAD_RETENTION_DAYS=90
# LEAD_PURGE_ENABLED=false
# CRM_SUMMARY_CACHE_ENABLED=true
# CRM_SUMMARY_CACHE_TTL_SECONDS=300

# --- Bot webhook ---
# POST https://api.${DOMAIN}/api/v1/bot-events

# --- Telephony WebRTC media relay (coturn) ---
# PBX_DOMAIN=pbx.${DOMAIN}
# TURN_REALM=pbx.${DOMAIN}
# TURN_PUBLIC_IP=203.0.113.10
# TURN_USERNAME=crm
# TURN_PASSWORD=CHANGE_ME_turn_password
# TURN_PORT=3478
# TURN_RELAY_MIN_PORT=49160
# TURN_RELAY_MAX_PORT=49200
# TELEPHONY_STUN_URLS=stun:stun.l.google.com:19302
# TELEPHONY_TURN_URLS=turn:pbx.${DOMAIN}:3478?transport=udp,turn:pbx.${DOMAIN}:3478?transport=tcp
# TELEPHONY_TURN_USERNAME=crm
# TELEPHONY_TURN_PASSWORD=CHANGE_ME_turn_password
