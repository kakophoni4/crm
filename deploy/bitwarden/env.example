# Vaultwarden (Bitwarden-compatible) — copy to deploy/bitwarden/.env
# Generate ADMIN_TOKEN: openssl rand -base64 48

DOMAIN=https://huitawarden.bttsrvvrs.org
ADMIN_TOKEN=CHANGE_ME_generate_with_openssl_rand_base64_48

# Local port (nginx proxies 127.0.0.1:VAULTWARDEN_PORT → container)
VAULTWARDEN_PORT=19180

# Security: disable open registration; invite users from /admin
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
SHOW_PASSWORD_HINT=false

LOG_LEVEL=warn
EXTENDED_LOGGING=false
