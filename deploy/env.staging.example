# CRM Chat Center — staging / VPS (copy to deploy/.env.staging, fill secrets).
# Do NOT commit deploy/.env.staging

# --- DNS & TLS ---
DOMAIN=staging.example.com
ACME_EMAIL=ops@example.com
# Let's Encrypt staging CA (fake certs). Remove or override in prod.
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# Traefik + TLS on VPS. For local HTTP smoke, omit this and add -f docker/docker-compose.local.yaml
COMPOSE_PROFILES=with-proxy

# --- Images (local build or GHCR from docker-build workflow) ---
# Local build (default):
CRM_API_IMAGE=crm-api:local
CRM_WORKER_IMAGE=crm-worker:local
CRM_FRONTEND_IMAGE=crm-frontend:local
#
# GHCR via override (recommended for VPS CD — copy override example, then set):
#   cp deploy/staging/docker-compose.override.yaml.example deploy/staging/docker-compose.override.yaml
#   GHCR_OWNER=your-github-org-or-user
#   CRM_IMAGE_TAG=latest
#   SKIP_COMPOSE_BUILD=1
# migrate_and_up.sh auto-detects deploy/staging/docker-compose.override.yaml and skips build.

# --- App secrets (generate: openssl rand -hex 32) ---
JWT_SECRET=CHANGE_ME_min_32_characters________
PGCRYPTO_KEY=CHANGE_ME_pgcrypto_key_________

# --- Database (internal hostname postgres — no host port publish) ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=crm
# Password here must match POSTGRES_PASSWORD (migrate_and_up validates this).
DATABASE_URL=postgresql+asyncpg://crm:CHANGE_ME_postgres_password@postgres:5432/crm
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO in stack) ---
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=CHANGE_ME_minio_password
S3_BUCKET_FILES=crm-files
S3_BUCKET_BACKUPS=crm-backups

# --- Post-deploy smoke (curl -k when using Let's Encrypt *staging* CA above) ---
SMOKE_TLS_INSECURE=true

# --- Runtime ---
APP_ENV=staging
APP_DEBUG=false
# Share-link URLs (frontend origin — NOT the API host)
# APP_PUBLIC_BASE_URL=https://chat.staging.example.com
# Public API origin for Telegram webhooks (notification bot, etc.)
# APP_API_PUBLIC_BASE_URL=https://api.staging.example.com
OWNERSHIP_V2=true
METRICS_ENABLED=true
WORKERS_IN_API=false
CORS_ALLOWED_ORIGINS=https://app.staging.example.com
LOG_JSON=true
LOG_LEVEL=INFO

# --- Sentry ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Frontend build args (baked into crm-frontend image) ---
VITE_API_BASE_URL=https://api.staging.example.com/api/v1
VITE_WS_URL=wss://api.staging.example.com/api/v1/ws
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=staging

# --- SMTP (real relay on staging; omit host to disable mail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=no-reply@staging.example.com

# --- One-time admin seed (staging only; leave empty after first boot) ---
SEED_ADMIN_EMAIL=admin@staging.example.com
SEED_ADMIN_PASSWORD=ChangeMe!Staging234

# --- Grafana (when using monitoring overlay) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana
GRAFANA_ROOT_URL=https://grafana.staging.example.com

# --- Leads v1.2 (staging may mirror prod flags) ---
# LEAD_RETENTION_DAYS=90
# LEAD_PURGE_ENABLED=false
# CRM_SUMMARY_CACHE_ENABLED=true
# CRM_SUMMARY_CACHE_TTL_SECONDS=300

# --- 1C Mole (OPT wholesale: Excel заявка → POST JSON в 1С) ---
# MOLE_API_BASE_URL=http://45.142.193.159/base
# MOLE_API_ORDERS_PATH=/hs/mole/orders
# MOLE_API_USERNAME=...
# MOLE_API_PASSWORD=...
# MOLE_API_TIMEOUT_SECONDS=60
# OPT_VAT_RATE_PERCENT=22

# --- Accounting / sbis-norm FNS requirements ---
# ACCOUNTING_INGEST_TOKEN=
# LAVOK_PARSER_INGEST_TOKEN=
# SMERTNIKI_API_URL=http://smertniki.example:8088
# SMERTNIKI_API_TOKEN=
# Публичный IP (не 127.0.0.1) — с CRM/другого сервера:
SBIS_NORM_API_BASE_URL=http://sbis-norm.example:8000
# SBIS_NORM_API_TOKEN=
SBIS_NORM_SYNC_ENABLED=true
# agent = UI «Забрать» sets Redis flag; kali scripts/sbis_norm_host_pull.py --daemon
# direct = CRM worker downloads from sbis (needs working CRM→sbis body path)
SBIS_NORM_SYNC_MODE=agent
SBIS_NORM_SYNC_INTERVAL_SECONDS=43200
# SBIS_NORM_SYNC_BATCH_LIMIT=20
# SBIS_NORM_API_TIMEOUT_SECONDS=120
# SBIS_NORM_WEBHOOK_TOKEN=
# On sbis-norm set:
#   REQUIREMENTS_WEBHOOK_URL=https://api.${DOMAIN}/api/v1/accounting/requirements/webhook
#   REQUIREMENTS_WEBHOOK_TOKEN=<same as SBIS_NORM_WEBHOOK_TOKEN>

# --- WhatsApp bridge (wa-crm-bridge systemd on host) ---
# Generate: openssl rand -hex 24
# WA_BRIDGE_SYNC_SECRET=
# WA_BRIDGE_WEBHOOK_PUBLIC_BASE=https://api.${DOMAIN}/green/webhook
# WA_BRIDGE_OUTBOUND_URL=http://host.docker.internal:8766/crm/cmd
# WA_BRIDGE_HEALTH_URL=http://host.docker.internal:8766/crm/health

# --- Bot webhook (configure in bot provider) ---
# POST https://api.${DOMAIN}/api/v1/bot-events

# --- Telephony WebRTC media relay (coturn, generated by telephony-up.sh on VPS) ---
# PBX_DOMAIN=pbx.${DOMAIN}
# TURN_REALM=pbx.${DOMAIN}
# TURN_PUBLIC_IP=203.0.113.10
# TURN_USERNAME=crm
# TURN_PASSWORD=CHANGE_ME_turn_password
# TURN_PORT=3478
# TURN_RELAY_MIN_PORT=49160
# TURN_RELAY_MAX_PORT=49200
# TELEPHONY_STUN_URLS=stun:stun.l.google.com:19302
# TELEPHONY_TURN_URLS=turn:pbx.${DOMAIN}:3478?transport=udp,turn:pbx.${DOMAIN}:3478?transport=tcp
# TELEPHONY_TURN_USERNAME=crm
# TELEPHONY_TURN_PASSWORD=CHANGE_ME_turn_password
