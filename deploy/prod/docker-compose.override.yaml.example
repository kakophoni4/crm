# GHCR image overrides for production CD (copy to deploy/prod/docker-compose.override.yaml).
# Required in deploy/.env.prod:
#   GHCR_OWNER=your-github-org-or-user
# Set CRM_IMAGE_TAG via Deploy Production workflow input or in deploy/.env.prod.

services:
  api:
    image: ghcr.io/${GHCR_OWNER}/crm-api:${CRM_IMAGE_TAG:-latest}
  worker:
    image: ghcr.io/${GHCR_OWNER}/crm-worker:${CRM_IMAGE_TAG:-latest}
  frontend:
    image: ghcr.io/${GHCR_OWNER}/crm-frontend:${CRM_IMAGE_TAG:-latest}
