{
  "name": "crm-chat-center-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript http://localhost:8000/api/openapi.json -o src/shared/api/types.generated.ts"
  },
  "dependencies": {
    "@sentry/vue": "^9.47.1",
    "@vueuse/core": "^10.11.1",
    "axios": "^1.7.7",
    "date-fns": "^3.6.0",
    "lucide-vue-next": "^0.460.0",
    "naive-ui": "^2.40.1",
    "pinia": "^2.2.4",
    "sip.js": "^0.21.2",
    "ulid": "^2.3.0",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/test-utils": "^2.4.6",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.31.0",
    "happy-dom": "^15.11.0",
    "openapi-typescript": "^7.4.2",
    "postcss-html": "^1.7.0",
    "prettier": "^3.3.3",
    "stylelint": "^16.10.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4",
    "vue-tsc": "^2.1.10"
  }
}
