APP_ENV=dev
APP_DEBUG=true
APP_PORT=8000
# Frontend origin for public share links (/share/:token)
APP_PUBLIC_BASE_URL=http://localhost:5173
JWT_SECRET=changeme_dev_secret_min_32_chars_xxxxxx
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5433/crm
REDIS_URL=redis://localhost:6379/0
SEED_ADMIN_EMAIL=admin@crm.local
SEED_ADMIN_PASSWORD=ChangeMe!234567
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniominio
S3_BUCKET_FILES=crm-files
S3_BUCKET_BACKUPS=crm-backups
PGCRYPTO_KEY=changeme_dev_pgcrypto_key
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.0
# Prometheus /metrics (set true when running with monitoring stack or local scrape)
METRICS_ENABLED=false
# Grafana (docker-compose.monitoring.yaml — dev only, change in prod)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_ROOT_URL=http://localhost:3000
# Backup scripts (scripts/backup_*.sh | .ps1) — run via cron / Task Scheduler
BACKUP_DIR=./backups/postgres
MINIO_BACKUP_DIR=./backups/minio
BACKUP_RETENTION_DAYS=14
POSTGRES_CONTAINER=crm-postgres
MINIO_CONTAINER=crm-minio
LOG_PII_MASK=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@crm.local
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_PHOTO_BYTES=10485760
MAX_UPLOAD_FILE_BYTES=52428800

# 1C Mole (OPT wholesale) — POST {MOLE_API_BASE_URL}/hs/mole/orders
# Flow: operator uploads Excel заявка → CRM parses rows → queue → JSON payload with CRMid.
# Buyer KPP/name: opt_buyers table + EGRUL lookup on upload (opt-known-buyers.json bootstrap).
# Supplier KPP/name: opt_units (run: py scripts/opt_enrich_requisites.py, then seed-opt-lavki.sh).
# MOLE_API_BASE_URL=http://45.142.193.159/base
# MOLE_API_ORDERS_PATH=/hs/mole/orders
# MOLE_API_USERNAME=...
# MOLE_API_PASSWORD=...
# OPT_VAT_RATE_PERCENT=20

# Leads retention (v1.1): days until purge eligibility; NULL/empty = forever
# LEAD_PURGE_ENABLED=true
# LEAD_RETENTION_DAYS=365
