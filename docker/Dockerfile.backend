# syntax=docker/dockerfile:1
# CRM Chat Center — API (multi-stage: builder → runtime, non-root uid 1000)

FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY app ./app

RUN pip install --upgrade pip \
    && pip install .

# ---------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid 1000 --create-home --shell /usr/sbin/nologin appuser

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY --chown=appuser:appuser app ./app
COPY --chown=appuser:appuser alembic ./alembic
COPY --chown=appuser:appuser scripts/opt_enrich_db_units.py ./scripts/opt_enrich_db_units.py
COPY --chown=appuser:appuser scripts/opt_recalc_vat_lines.py ./scripts/opt_recalc_vat_lines.py
COPY --chown=appuser:appuser scripts/opt_retry_submit.py ./scripts/opt_retry_submit.py
COPY --chown=appuser:appuser scripts/scan_nds_request_files.py ./scripts/scan_nds_request_files.py
COPY --chown=appuser:appuser scripts/opt_deleted_orders.py ./scripts/opt_deleted_orders.py
COPY --chown=appuser:appuser scripts/opt_find_deleted_orders.sh ./scripts/opt_find_deleted_orders.sh
COPY --chown=appuser:appuser scripts/bots/resync_bot_group_assignments.py ./scripts/resync_bot_group_assignments.py
COPY --chown=appuser:appuser alembic.ini pyproject.toml README.md ./

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
