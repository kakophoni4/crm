# syntax=docker/dockerfile:1
# CRM Chat Center — background workers (standalone image, no local API image dependency)

FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120

WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libffi-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
# Stub package so pip can install deps without copying all of app/ (keeps this layer cached).
RUN mkdir -p app && touch app/__init__.py

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip \
    && pip install --retries 15 --timeout 120 .

# ---------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid 1000 --create-home --shell /usr/sbin/nologin appuser

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY --chown=appuser:appuser app ./app
COPY --chown=appuser:appuser scripts/opt_enrich_db_units.py ./scripts/opt_enrich_db_units.py
COPY --chown=appuser:appuser scripts/opt_recalc_vat_lines.py ./scripts/opt_recalc_vat_lines.py
COPY --chown=appuser:appuser scripts/opt_retry_submit.py ./scripts/opt_retry_submit.py
COPY --chown=appuser:appuser scripts/bots/resync_bot_group_assignments.py ./scripts/resync_bot_group_assignments.py
COPY --chown=appuser:appuser pyproject.toml README.md ./

USER appuser

CMD ["python", "-m", "app.workers.run"]
