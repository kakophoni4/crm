# Bridge reads WhatsApp bot configs from CRM (Admin → Боты).
CRM_API_BASE=http://127.0.0.1:19001
WA_BRIDGE_SYNC_SECRET=

LISTEN_HOST=0.0.0.0
LISTEN_PORT=8766

# Optional: require this header on GREEN webhook POST
WEBHOOK_TOKEN=

# CRM API (.env) must contain the same WA_BRIDGE_SYNC_SECRET.
# Also set (for auto webhook URL + bridge outbound):
#   WA_BRIDGE_WEBHOOK_PUBLIC_BASE=https://api.crmkanasha.org/green/webhook
#   WA_BRIDGE_OUTBOUND_URL=http://host.docker.internal:8766/crm/cmd
#   WA_BRIDGE_HEALTH_URL=http://host.docker.internal:8766/crm/health
