# GREEN API credentials (from https://console.green-api.com)
GREEN_API_URL=https://api.green-api.com
GREEN_MEDIA_URL=https://media.green-api.com
GREEN_INSTANCE_ID=
GREEN_API_TOKEN=

# CRM bot record (create via scripts/bots/provision_whatsapp_bot.sh)
CRM_API_BASE=https://api.crmkanasha.org
BOT_CODE=whatsapp_support_1
INBOUND_SECRET=
OUTBOUND_SECRET=

# Bridge HTTP server
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8766

# Optional: require this header on GREEN webhook POST
WEBHOOK_TOKEN=

# URLs registered in CRM (worker reaches host via Docker gateway on VPS)
OUTBOUND_URL=http://host.docker.internal:8766/crm/cmd
HEALTH_URL=http://host.docker.internal:8766/crm/health

# Public URL for GREEN API console webhook settings, e.g.:
# WEBHOOK_PUBLIC_URL=https://wa-bridge.yourdomain.org/green/webhook
