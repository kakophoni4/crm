# Copy to /root/crm-bots/.env and fill TG_BOT_TOKEN from @BotFather
TG_BOT_TOKEN=
CRM_API_BASE=https://api.crmkanasha.org
BOT_CODE=test_bot_1
INBOUND_SECRET=
OUTBOUND_SECRET=
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8765
# URL registered in CRM (worker reaches host via Docker gateway)
OUTBOUND_URL=http://host.docker.internal:8765/crm/cmd
HEALTH_URL=http://host.docker.internal:8765/crm/health

# --- Large files (>20 MB) ---
# Cloud default (hard limit ~20 MB for bot downloads):
# TG_API_BASE=https://api.telegram.org
# TG_FILE_BASE=https://api.telegram.org
# TG_MAX_FILE_BYTES=20971520
#
# After Local Bot API (bash scripts/bots/tg_crm_bridge/install-local-bot-api.sh):
# TG_API_BASE=http://127.0.0.1:8081
# TG_FILE_BASE=http://host.docker.internal:8081
# TG_MAX_FILE_BYTES=104857600
